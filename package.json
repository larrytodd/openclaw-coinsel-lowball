  },
  "keywords": ["openclaw", "openclaw-plugin", "coins", "numismatics", "coin-value", "collectibles", "pricing"],
  "files": ["dist", "openclaw.plugin.json", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
